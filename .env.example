# Default: explicitly labeled authored extraction, durable local SQLite.
STORAGE_BACKEND=sqlite
DATABASE_PATH=.data/batchlens.db
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:5173

# Enable live Gemini by setting MODEL_ID and either an API key or Google Cloud project.
MODEL_ID=
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
DAILY_MODEL_CALL_LIMIT=100

# Cloud Run: STORAGE_BACKEND=firestore, COOKIE_SECURE=true.
# Use Application Default Credentials with a dedicated service identity.

# Optional named Firestore database; deployed BatchLens uses its own database.
FIRESTORE_DATABASE=(default)
# Cloud Run fails startup if MODEL_ID or Cloud credentials are missing.
